---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard  from '../components/VideoCard.astro';
import { videos, CATEGORIES, SITE_CONFIG } from '../data/videos';

// Sort by date (newest first) for initial render
const sorted = [...videos].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const totalVideos = sorted.length;
const pageSize = SITE_CONFIG.videosPerPage;
const totalPages = Math.ceil(totalVideos / pageSize);

// Generate initial page numbers array with smart ellipsis for SSR HTML
const initialPageNumbers: (number | '...')[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) initialPageNumbers.push(i);
} else {
  initialPageNumbers.push(1);
  const end = Math.min(totalPages - 1, 3);
  for (let i = 2; i <= end; i++) initialPageNumbers.push(i);
  if (totalPages > 4) initialPageNumbers.push('...');
  initialPageNumbers.push(totalPages);
}
---

<BaseLayout
  title={`${SITE_CONFIG.name} – ${SITE_CONFIG.tagline}`}
  description={`Watch free premium adult videos on ${SITE_CONFIG.name}. Browse amateur, couples, solo, and compilation content.`}
  canonical={`${SITE_CONFIG.siteUrl}/`}
>

  <div class="container">

    <!-- ── Sort + Heading ── -->
    <div class="sort-bar">
      <h1 id="grid-heading" style="font-size:1.1rem;font-weight:700">Latest Videos</h1>
      <div class="sort-options" role="group" aria-label="Sort videos">
        <button class="sort-btn active" data-sort="date"  aria-pressed="true">Latest</button>
        <button class="sort-btn"        data-sort="views" aria-pressed="false">Most Viewed</button>
        <button class="sort-btn"        data-sort="alpha" aria-pressed="false">A–Z</button>
      </div>
    </div>

    <!-- ── Video Grid (pre-rendered for SEO) ── -->
    <div class="video-grid" id="video-grid" role="list" aria-label="Video list">
      {sorted.map(video => <VideoCard video={video} />)}
    </div>

    <!-- ── Empty State (hidden by default) ── -->
    <div class="empty-state" id="empty-state" style="display:none" aria-live="polite">
      <div class="empty-icon">🎬</div>
      <h3>No videos found</h3>
      <p>Try a different category.</p>
    </div>

    <!-- ── View More ── -->
    <div class="load-more-wrap" id="load-more-wrap">
      <button class="btn btn-ghost" id="load-more-btn">View More Videos</button>
    </div>

    <!-- ── Pagination Navigation ── -->
    {totalPages > 1 && (
      <nav class="pagination-wrap" id="pagination-wrap" aria-label="Pagination Navigation">
        <div class="pagination-nav" id="pagination-nav">
          <span class="pagination-btn disabled" aria-disabled="true">‹ Prev</span>
          {initialPageNumbers.map((num) => {
            if (num === '...') {
              return <span class="pagination-ellipsis">&hellip;</span>;
            }
            return num === 1 ? (
              <span class="pagination-btn active" aria-current="page">1</span>
            ) : (
              <a href={`?page=${num}`} class="pagination-btn" data-page={num} aria-label={`Go to page ${num}`}>{num}</a>
            );
          })}
          <a href="?page=2" class="pagination-btn" data-page="2" rel="next" aria-label="Next page">Next ›</a>
        </div>

        <div class="pagination-info" id="pagination-info">
          Showing <strong>1–{Math.min(pageSize, totalVideos)}</strong> of <strong>{totalVideos}</strong> videos (Page 1 of {totalPages})
        </div>
      </nav>
    )}

  </div>
</BaseLayout>

<script define:vars={{ PER_PAGE: SITE_CONFIG.videosPerPage }}>
  // ════════════════════════════════════════════════════════
  //  HOMEPAGE CLIENT LOGIC
  //  All cards are pre-rendered in the HTML (good for SEO).
  //  JS handles: category filter, sort, view more, pagination, view counts.
  // ════════════════════════════════════════════════════════

  const grid           = document.getElementById('video-grid');
  const emptyState     = document.getElementById('empty-state');
  const loadWrap       = document.getElementById('load-more-wrap');
  const loadBtn        = document.getElementById('load-more-btn');
  const heading        = document.getElementById('grid-heading');
  const paginationWrap = document.getElementById('pagination-wrap');
  const paginationNav  = document.getElementById('pagination-nav');
  const paginationInfo = document.getElementById('pagination-info');

  let allCards     = [];
  let visibleCards = [];
  let currentCat   = 'All';
  let currentSort  = 'date';
  let currentPage  = 1;
  let visibleStart = 0;
  let visibleEnd   = PER_PAGE;

  /** Get all video-card elements in DOM order */
  function getCards() {
    return Array.from(grid?.querySelectorAll('.video-card') ?? []);
  }

  /** Parse a "12K", "1.2M" string to a number for sorting */
  function parseViews(str) {
    const n = parseFloat(str || '0');
    const u = (str || '').toUpperCase();
    if (u.includes('M')) return n * 1_000_000;
    if (u.includes('K')) return n * 1_000;
    return n;
  }

  /** Sort cards in-place and re-append to grid */
  function sortCards(cards, sort) {
    const order = [...cards];
    if (sort === 'date') {
      order.sort((a, b) => new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime());
    } else if (sort === 'views') {
      // Sort automatically by view count descending
      order.sort((a, b) => {
        const av = parseInt(a.dataset.views || a.querySelector('.card-view-count')?.dataset.rawViews || '0');
        const bv = parseInt(b.dataset.views || b.querySelector('.card-view-count')?.dataset.rawViews || '0');
        return bv - av;
      });
    } else if (sort === 'alpha') {
      order.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
    }
    order.forEach(c => grid?.appendChild(c));
    return order;
  }

  /** Render pagination navigation controls */
  function renderPagination(totalItems, current, startIdx, endIdx) {
    if (!paginationWrap || !paginationNav || !paginationInfo) return;

    const totalPages = Math.ceil(totalItems / PER_PAGE);
    if (totalPages <= 1) {
      paginationWrap.style.display = 'none';
      return;
    }

    paginationWrap.style.display = 'flex';

    // Info text
    const displayStart = totalItems === 0 ? 0 : startIdx + 1;
    const displayEnd   = endIdx;
    paginationInfo.innerHTML = `Showing <strong>${displayStart}–${displayEnd}</strong> of <strong>${totalItems}</strong> videos (Page ${current} of ${totalPages})`;

    // Generate page numbers array with smart ellipsis
    const pageNumbers = [];
    if (totalPages <= 7) {
      for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
    } else {
      pageNumbers.push(1);
      if (current > 3) pageNumbers.push('...');
      const s = Math.max(2, current - 1);
      const e = Math.min(totalPages - 1, current + 1);
      for (let i = s; i <= e; i++) pageNumbers.push(i);
      if (current < totalPages - 2) pageNumbers.push('...');
      pageNumbers.push(totalPages);
    }

    let navHtml = '';

    // Prev Button
    if (current > 1) {
      navHtml += `<a href="?page=${current - 1}" class="pagination-btn" data-page="${current - 1}" rel="prev" aria-label="Previous page">‹ Prev</a>`;
    } else {
      navHtml += `<span class="pagination-btn disabled" aria-disabled="true">‹ Prev</span>`;
    }

    // Page Numbers
    pageNumbers.forEach(num => {
      if (num === '...') {
        navHtml += `<span class="pagination-ellipsis">&hellip;</span>`;
      } else if (num === current) {
        navHtml += `<span class="pagination-btn active" aria-current="page">${num}</span>`;
      } else {
        navHtml += `<a href="?page=${num}" class="pagination-btn" data-page="${num}" aria-label="Go to page ${num}">${num}</a>`;
      }
    });

    // Next Button
    if (current < totalPages) {
      navHtml += `<a href="?page=${current + 1}" class="pagination-btn" data-page="${current + 1}" rel="next" aria-label="Next page">Next ›</a>`;
    } else {
      navHtml += `<span class="pagination-btn disabled" aria-disabled="true">Next ›</span>`;
    }

    paginationNav.innerHTML = navHtml;
  }

  /** Update cards visibility in grid */
  function updateCardsDisplay() {
    allCards.forEach(c => c.classList.add('hidden'));
    const slice = visibleCards.slice(visibleStart, visibleEnd);
    slice.forEach(c => c.classList.remove('hidden'));

    if (loadWrap) {
      loadWrap.style.display = visibleEnd < visibleCards.length ? 'block' : 'none';
    }

    renderPagination(visibleCards.length, currentPage, visibleStart, visibleEnd);
  }

  /** Jump to a specific page */
  function goToPage(targetPage, shouldScroll = false, pushToHistory = true) {
    const totalPages = Math.ceil(visibleCards.length / PER_PAGE) || 1;
    currentPage = Math.min(Math.max(1, targetPage), totalPages);

    visibleStart = (currentPage - 1) * PER_PAGE;
    visibleEnd   = Math.min(visibleStart + PER_PAGE, visibleCards.length);

    updateCardsDisplay();

    if (shouldScroll && grid) {
      const top = grid.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }

    if (pushToHistory) {
      const url = new URL(window.location.href);
      if (currentPage === 1) {
        url.searchParams.delete('page');
      } else {
        url.searchParams.set('page', String(currentPage));
      }
      history.pushState({ page: currentPage }, '', url.toString());
    }
  }

  /** Reveal next batch of cards (View More) */
  function showMore() {
    if (visibleEnd >= visibleCards.length) return;

    const nextBatchEnd = Math.min(visibleEnd + PER_PAGE, visibleCards.length);
    for (let i = visibleEnd; i < nextBatchEnd; i++) {
      visibleCards[i].classList.remove('hidden');
    }
    visibleEnd = nextBatchEnd;
    currentPage = Math.ceil(visibleEnd / PER_PAGE);

    if (loadWrap) {
      loadWrap.style.display = visibleEnd < visibleCards.length ? 'block' : 'none';
    }

    renderPagination(visibleCards.length, currentPage, visibleStart, visibleEnd);

    const url = new URL(window.location.href);
    if (currentPage === 1) {
      url.searchParams.delete('page');
    } else {
      url.searchParams.set('page', String(currentPage));
    }
    history.replaceState({ page: currentPage }, '', url.toString());
  }

  /** Apply current category filter and sort, then paginate */
  function applyFilters(preservePage = false) {
    allCards = getCards();

    // Filter by category or dynamic tab (Popular, Trending, Latest)
    if (currentCat === 'All') {
      visibleCards = allCards;
    } else if (currentCat === 'Popular' || currentCat === 'Trending') {
      visibleCards = allCards;
      currentSort = 'views';
      document.querySelectorAll('.sort-btn').forEach(b => {
        const isViews = b.dataset.sort === 'views';
        b.classList.toggle('active', isViews);
        b.setAttribute('aria-pressed', String(isViews));
      });
    } else if (currentCat === 'Latest') {
      visibleCards = allCards;
      currentSort = 'date';
      document.querySelectorAll('.sort-btn').forEach(b => {
        const isDate = b.dataset.sort === 'date';
        b.classList.toggle('active', isDate);
        b.setAttribute('aria-pressed', String(isDate));
      });
    } else {
      visibleCards = allCards.filter(c => (c.dataset.category || '').toLowerCase() === currentCat.toLowerCase());
    }

    // Sort visible set
    visibleCards = sortCards(visibleCards, currentSort);

    // Show empty state if needed
    if (emptyState) emptyState.style.display = visibleCards.length === 0 ? 'block' : 'none';

    if (visibleCards.length === 0) {
      allCards.forEach(c => c.classList.add('hidden'));
      if (loadWrap) loadWrap.style.display = 'none';
      if (paginationWrap) paginationWrap.style.display = 'none';
      return;
    }

    let targetPage = 1;
    if (preservePage) {
      const urlPage = parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10);
      const totalPages = Math.ceil(visibleCards.length / PER_PAGE);
      targetPage = Math.min(Math.max(1, urlPage), totalPages);
    }

    goToPage(targetPage, false, false);
  }

  // ── Sort buttons ─────────────────────────────────────────
  document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sort-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      currentSort = btn.dataset.sort || 'date';
      applyFilters(false);
    });
  });

  // ── View More Button ─────────────────────────────────────
  loadBtn?.addEventListener('click', showMore);

  // ── Pagination Nav Clicks (Event Delegation) ─────────────
  paginationNav?.addEventListener('click', (e) => {
    const link = e.target.closest('a.pagination-btn[data-page]');
    if (!link) return;
    e.preventDefault();
    const targetPage = parseInt(link.dataset.page || '1', 10);
    if (!isNaN(targetPage) && targetPage !== currentPage) {
      goToPage(targetPage, true, true);
    }
  });

  // ── Browser Back / Forward Handling ──────────────────────
  window.addEventListener('popstate', () => {
    const urlPage = parseInt(new URLSearchParams(window.location.search).get('page') || '1', 10);
    goToPage(urlPage, false, false);
  });

  // ── Load view counts for all cards & auto-sort popular ─────
  async function loadViewCounts() {
    const countEls = document.querySelectorAll('.card-view-count[data-slug]');
    if (!countEls.length) return;

    const slugs = Array.from(countEls).map(el => el.getAttribute('data-slug')).filter(Boolean);

    try {
      const res = await fetch(`/api/views?slugs=${encodeURIComponent(slugs.join(','))}`);
      if (res.ok) {
        const data = await res.json();
        const viewsMap = data.views || {};

        countEls.forEach((el) => {
          const slug = el.getAttribute('data-slug');
          if (slug && viewsMap[slug] !== undefined) {
            const views = viewsMap[slug];
            el.textContent = formatViews(views);
            el.dataset.rawViews = String(views);
            const card = el.closest('.video-card');
            if (card) card.dataset.views = String(views);
          }
        });

        // Automatically re-sort popular posts with real live view counts
        if (currentSort === 'views' || currentCat === 'Popular' || currentCat === 'Trending') {
          applyFilters(true);
        }
        return;
      }
    } catch {
      // Fallback to individual fetches
    }

    const fetches = Array.from(countEls).map(async (el) => {
      const slug = el.getAttribute('data-slug');
      if (!slug) return;
      try {
        const res = await fetch(`/api/views?slug=${encodeURIComponent(slug)}`);
        if (!res.ok) return;
        const { views } = await res.json();
        el.textContent = formatViews(views);
        el.dataset.rawViews = String(views);
        const card = el.closest('.video-card');
        if (card) card.dataset.views = String(views);
      } catch {}
    });
    await Promise.all(fetches);

    if (currentSort === 'views' || currentCat === 'Popular' || currentCat === 'Trending') {
      applyFilters(true);
    }
  }

  function formatViews(n) {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000)     return Math.floor(n / 1_000) + 'K';
    return String(n);
  }

  // ── Init ─────────────────────────────────────────────────
  applyFilters(true);
  loadViewCounts();
</script>
