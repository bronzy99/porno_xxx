---
// src/pages/videos/[slug].astro
// URL: /videos/gorgeous-amateur-couple-home-session/
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoCard  from '../../components/VideoCard.astro';
import { videos, slugify, formatDate, isAllowedEmbedUrl, getQualityTag, SITE_CONFIG, normalizeCategory } from '../../data/videos';

export function getStaticPaths() {
  return videos.map((video) => ({
    params: { slug: slugify(video.title) },
    props:  { video },
  }));
}

const { video }  = Astro.props;
const slug        = slugify(video.title);
const isAllowed   = isAllowedEmbedUrl(video.embedUrl);
const quality     = getQualityTag(video.tags);
const category    = normalizeCategory(video.category, video.tags);

// Related: same canonical category, exclude self, up to 8
const related = videos
  .filter((v) => v.id !== video.id && normalizeCategory(v.category, v.tags) === category)
  .slice(0, 8);

// Fallback: if no same-category videos, show latest from any category
const relatedVideos = related.length > 0
  ? related
  : videos.filter(v => v.id !== video.id).slice(0, 8);

const pageTitle = `${video.title} – ${SITE_CONFIG.name}`;
const canonical = `${SITE_CONFIG.siteUrl}/videos/${slug}/`;
---

<BaseLayout
  title={pageTitle}
  description={`Watch ${video.title} on ${SITE_CONFIG.name}. Category: ${video.category}. Tags: ${video.tags.join(', ')}.`}
  ogTitle={pageTitle}
  ogImage={video.thumbnail}
  canonical={canonical}
>
  <div class="container">
    <div class="watch-container">

      <!-- ── Watch Layout: Player on Left + 2x 300x250 Ads on Right (Desktop Only) ── -->
      <div class="watch-layout">

        <!-- ── Left Column: Video Player & Info ── -->
        <div class="watch-main">
          {isAllowed ? (
            <div class="video-player-wrap">
              <div class="video-player">
                <iframe
                  src={video.embedUrl}
                  title={video.title}
                  allowfullscreen
                  allow="autoplay; fullscreen; picture-in-picture"
                  loading="lazy"
                />
              </div>
            </div>
          ) : (
            <div class="player-blocked" role="alert">
              <p>⚠️ Player Unavailable</p>
              <p>
                The video provider is not on the authorized allowlist.<br>
                Add the hostname to <code>ALLOWED_EMBED_HOSTS</code> in <code>src/data/videos.ts</code>.
              </p>
            </div>
          )}

          <!-- ── Video Info ── -->
          <div class="watch-info">
            <h1 class="watch-title">{video.title}</h1>

            <div class="watch-meta">
              <!-- Live view count — updated by client script -->
              <span id="watch-view-meta">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
                <span id="watch-view-count" class="view-loading">Loading…</span>
              </span>

              <span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
                {formatDate(video.date)}
              </span>

              {quality && (
                <span class="quality-badge-inline">{quality}</span>
              )}

              <a href={`/category/${slugify(category)}/`} class="category-tag">
                {category}
              </a>
            </div>

            {video.tags.length > 0 && (
              <div class="watch-tags" aria-label="Tags">
                {video.tags.map(tag => (
                  <a href={`/tags/${slugify(tag)}/`} class="tag-pill">
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>

        <!-- ── Right Column: 2x 300x250 Ad Units (Desktop Only) ── -->
        <aside class="watch-sidebar" aria-label="Advertisements">
          <div class="ad-slot ad-300x250">
            <span class="ad-label">Advertisement</span>
            <div class="ad-content">
              <!-- AD SLOT 1 (300x250) — Insert ad network code, banner, or iframe here -->
              <div class="ad-placeholder">
                <span class="ad-dimensions">300 × 250</span>
                <span class="ad-subtitle">Ad Slot 1</span>
              </div>
            </div>
          </div>

          <div class="ad-slot ad-300x250">
            <span class="ad-label">Advertisement</span>
            <div class="ad-content">
              <!-- AD SLOT 2 (300x250) — Insert ad network code, banner, or iframe here -->
              <div class="ad-placeholder">
                <span class="ad-dimensions">300 × 250</span>
                <span class="ad-subtitle">Ad Slot 2</span>
              </div>
            </div>
          </div>
        </aside>

      </div>

      <!-- ── Related Videos Grid (Full Width below) ── -->
      {relatedVideos.length > 0 && (
        <section class="related-section" aria-label="Related videos">
          <h2>{related.length > 0 ? 'Related Videos' : 'More Videos'}</h2>
          <div class="video-grid">
            {relatedVideos.map(v => <VideoCard video={v} />)}
          </div>
        </section>
      )}

    </div>
  </div>
</BaseLayout>

<script define:vars={{ videoSlug: slug }}>
  // ════════════════════════════════════════════════════════
  //  VIEW TRACKING
  //  - POST once per session to increment the KV counter
  //  - GET to read the current count if already visited
  //  - sessionStorage prevents double-counting on refresh
  // ════════════════════════════════════════════════════════

  const SESSION_KEY = `viewed:${videoSlug}`;
  const viewCountEl = document.getElementById('watch-view-count');

  function formatViews(n) {
    if (!n && n !== 0) return '—';
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000)     return Math.floor(n / 1_000) + 'K';
    return String(n);
  }

  async function trackView() {
    const alreadyCounted = sessionStorage.getItem(SESSION_KEY);
    const method = alreadyCounted ? 'GET' : 'POST';

    try {
      const res = await fetch(`/api/views?slug=${encodeURIComponent(videoSlug)}`, { method });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const { views } = await res.json();

      if (!alreadyCounted) {
        sessionStorage.setItem(SESSION_KEY, '1');
      }

      if (viewCountEl) {
        viewCountEl.textContent = formatViews(views) + ' views';
        viewCountEl.classList.remove('view-loading');
      }

      // Also update related card view counts
      document.querySelectorAll('.card-view-count[data-slug]').forEach(async (el) => {
        const s = el.getAttribute('data-slug');
        if (!s) return;
        try {
          const r = await fetch(`/api/views?slug=${encodeURIComponent(s)}`);
          if (!r.ok) return;
          const { views: v } = await r.json();
          el.textContent = formatViews(v);
        } catch { el.textContent = '—'; }
      });

    } catch {
      if (viewCountEl) {
        viewCountEl.textContent = '—';
        viewCountEl.classList.remove('view-loading');
      }
    }
  }

  trackView();
</script>
