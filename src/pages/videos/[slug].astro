---
// src/pages/videos/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoCard  from '../../components/VideoCard.astro';
import {
  videos,
  slugify,
  formatDate,
  isAllowedEmbedUrl,
  getQualityTierBadge,
  SITE_CONFIG,
  normalizeCategory
} from '../../data/videos';

export function getStaticPaths() {
  return videos.map((video) => ({
    params: { slug: slugify(video.title) },
    props:  { video },
  }));
}

const { video }   = Astro.props;
const slug         = slugify(video.title);
const isAllowed    = video.embedUrl ? isAllowedEmbedUrl(video.embedUrl) : false;
const qualityTier  = getQualityTierBadge(video);
const category     = video.category || 'Movies';
const studio       = video.studio || category;
const posterImg    = video.poster || video.thumbnail;
const scenes       = video.scenes || [];
const hasScenes    = scenes.length > 0;
const screenshots  = video.screenshots || [];
const hasScreens   = screenshots.length > 0;
const castMembers  = video.cast || [];
const streamLink   = video.streamUrl || video.downloadUrl || video.embedUrl || `#stream-movie`;
const likesCount   = video.likes ?? 6;
const dislikesCount = video.dislikes ?? 2;

// Related movies (same category, up to 10)
const related = videos
  .filter((v) => v.id !== video.id && (v.category || '') === category)
  .slice(0, 10);

const relatedVideos = related.length > 0
  ? related
  : videos.filter((v) => v.id !== video.id).slice(0, 10);

const pageTitle = `${video.title} – ${SITE_CONFIG.name}`;
const canonical = `${SITE_CONFIG.siteUrl}/videos/${slug}/`;

// Optimized SEO Meta Description (140-155 characters)
const displayTitle = (video.cleanTitle || video.title.replace(/\[.*?\]|\(.*?\)/g, '').trim()).slice(0, 50);
const topCast = castMembers.slice(0, 2).join(', ');
const starSnippet = topCast ? ` Starring ${topCast}.` : ` Category: ${category}.`;
let metaDesc = `Watch and stream ${displayTitle} in ${video.quality || '1080p'}.${starSnippet} Free on ${SITE_CONFIG.name}.`;
if (metaDesc.length > 155) {
  metaDesc = metaDesc.slice(0, 152).trim() + '...';
}
---

<BaseLayout
  title={pageTitle}
  description={metaDesc}
  ogTitle={pageTitle}
  ogImage={posterImg}
  canonical={canonical}
>
  <div class="container">
    <article class="movie-page-wrap">

      <!-- ── Breadcrumb ── -->
      <nav class="movie-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href={`/category/${slugify(category)}/`}>{category}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{video.cleanTitle || video.title}</span>
      </nav>

      <!-- ── Post Title ── -->
      <h1 class="movie-post-title">{video.title}</h1>

      <!-- ── Main Hero Section (Poster on Left + Description & Details Box on Right) ── -->
      <div class="movie-hero">

        <!-- Left: Movie Poster Card (No Studio Badge on Poster) -->
        <div class="movie-poster-card">
          <div class="poster-img-container">
            <!-- Quality Tier Tag Badge Only -->
            <span class={`quality-badge ${qualityTier.tierClass}`}>
              {qualityTier.label}
            </span>

            <img
              class="poster-main-img"
              src={posterImg}
              alt={video.title}
              width="450"
              height="675"
              referrerpolicy="no-referrer"
              onerror="this.src='https://picsum.photos/450/675?grayscale'"
            />
          </div>
        </div>

        <!-- Right: Description Section (Replacing old metadata/torrent box) -->
        <div class="movie-desc-card">
          <div class="movie-meta-header">
            <a href={`/category/${slugify(category)}/`} class="category-pill" title={`Category: ${category}`}>
              {category}
            </a>
            {video.releaseYear && <span class="year-badge">{video.releaseYear}</span>}
            <span class="hd-badge-text">{video.quality || qualityTier.label}</span>
            <span class="duration-text">{video.duration}</span>
          </div>

          <div class="desc-info-rows">
            {castMembers.length > 0 && (
              <div class="desc-meta-row">
                <span class="row-label">Cast:</span>
                <div class="meta-inline-items">
                  {castMembers.map((actor, idx) => (
                    <span class="meta-inline-item">
                      <a href={`/cast/${slugify(actor)}/`} class="meta-link">{actor}</a>{idx < castMembers.length - 1 ? ', ' : ''}
                    </span>
                  ))}
                </div>
              </div>
            )}

            {(video.genres || video.tags).length > 0 && (
              <div class="desc-meta-row">
                <span class="row-label">Genre:</span>
                <div class="meta-inline-items">
                  {(video.genres || video.tags).map((g, idx, arr) => (
                    <span class="meta-inline-item">
                      <a href={`/genres/${slugify(g)}/`} class="meta-link">{g}</a>{idx < arr.length - 1 ? ', ' : ''}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <div class="desc-meta-row">
              <span class="row-label">Category / Studio:</span>
              <div class="meta-inline-items">
                <a href={`/category/${slugify(category)}/`} class="studio-link">{category}</a>
                {video.studio && video.studio !== category && (
                  <span class="studio-subtext"> / {video.studio}</span>
                )}
              </div>
            </div>

            <div class="desc-meta-row">
              <span class="row-label">Split into episodes:</span>
              <span>{video.splitScenes || hasScenes ? `Yes (${scenes.length || 'Split'} Scenes)` : 'Full Movie'}</span>
            </div>
          </div>

          <!-- Synopsis Storyline -->
          {video.synopsis && (
            <div class="synopsis-box">
              <h3 class="synopsis-heading">Synopsis:</h3>
              <p class="synopsis-text">{video.synopsis}</p>
            </div>
          )}

          <!-- Stream Action Buttons (Individual Scene Streams) -->
          <div class="meta-scene-downloads">
            <div class="meta-scene-heading">
              <span class="scene-heading-title">Stream:</span>
              {hasScenes && <span class="scene-heading-count">({scenes.length} Scenes)</span>}
            </div>
            <div class="scene-download-buttons">
              {hasScenes ? (
                scenes.map((scene) => {
                  const sLink = scene.streamUrl || scene.downloadUrl || streamLink;
                  return (
                    <a
                      href={sLink}
                      class="btn btn-scene-card"
                      title={`Stream Scene ${scene.sceneNumber}: ${scene.title || scene.filename || ''}`}
                    >
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                      <span class="scene-btn-text">Scene {scene.sceneNumber}</span>
                      {scene.duration && <span class="scene-btn-duration">({scene.duration})</span>}
                    </a>
                  );
                })
              ) : (
                <a
                  href={streamLink}
                  class="btn btn-scene-card"
                  title={`Stream ${video.cleanTitle || video.title}`}
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <span class="scene-btn-text">Stream Movie</span>
                  {video.duration && <span class="scene-btn-duration">({video.duration})</span>}
                </a>
              )}
            </div>
          </div>

          {video.embedUrl && (
            <div class="stream-online-toggle">
              <button type="button" class="btn btn-secondary btn-sm" id="toggle-stream-btn">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                Watch Stream Online
              </button>
            </div>
          )}
        </div>

      </div>

      <!-- ── Optional Stream Player (if embedUrl provided) ── -->
      {video.embedUrl && (
        <div class="stream-player-section" id="stream-player-section" style="display:none">
          <div class="stream-player-header">
            <h3>Online Video Stream</h3>
            <button type="button" class="btn-close-stream" id="close-stream-btn">&times;</button>
          </div>
          {isAllowed ? (
            <div class="video-player-wrap">
              <div class="video-player">
                <iframe
                  src={video.embedUrl}
                  title={video.title}
                  allowfullscreen
                  allow="autoplay; fullscreen; picture-in-picture"
                  loading="lazy"
                />
              </div>
            </div>
          ) : (
            <div class="player-blocked">
              <p>Player Host Not Authorized</p>
            </div>
          )}
        </div>
      )}

      <!-- ── Rating Bar ── -->
      <div class="movie-rating-bar">
        <span class="rating-title">Rating :</span>
        <div class="rating-buttons" role="group" aria-label="User rating">
          <button class="rating-btn btn-like" id="btn-like" aria-pressed="false">
            <span class="rating-icon">👍</span>
            <span id="like-count">{likesCount} Likes</span>
          </button>
          <button class="rating-btn btn-dislike" id="btn-dislike" aria-pressed="false">
            <span class="rating-icon">👎</span>
            <span id="dislike-count">{dislikesCount} Dislikes</span>
          </button>
        </div>
      </div>

      <!-- ── Movie Screenshots Section ── -->
      {hasScreens && (
        <section class="movie-screenshots-section" aria-label="Movie screenshots and proof sheets">
          <div class="screenshots-header">
            <div class="screenshots-title-wrap">
              <h2 class="section-title">Movie Screenshots :</h2>
              <span class="screenshots-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
                1024 × 2079 Full Resolution
              </span>
            </div>

            <div class="screenshots-view-controls">
              <span class="view-label">Display Mode:</span>
              <button type="button" class="btn-view-mode active" id="btn-view-grid" title="Compact grid view">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <rect x="3" y="3" width="7" height="7" rx="1"/>
                  <rect x="14" y="3" width="7" height="7" rx="1"/>
                  <rect x="3" y="14" width="7" height="7" rx="1"/>
                  <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
                Grid
              </button>
              <button type="button" class="btn-view-mode" id="btn-view-full" title="Display full width images inline (1024px)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <rect x="3" y="4" width="18" height="6" rx="1"/>
                  <rect x="3" y="14" width="18" height="6" rx="1"/>
                </svg>
                Full Width
              </button>
            </div>
          </div>

          <div class="screenshots-grid" id="screenshots-grid">
            {screenshots.map((src, idx) => (
              <div class="screenshot-item">
                <div class="screenshot-thumb-box">
                  <a
                    href={src}
                    class="screenshot-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    data-lightbox="screens"
                    data-src={src}
                    data-index={idx}
                  >
                    <img
                      src={src}
                      alt={`Screenshot proof ${idx + 1} for ${video.title}`}
                      loading="lazy"
                      class="screenshot-img"
                      referrerpolicy="no-referrer"
                    />
                    <div class="screenshot-hover-overlay">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        <line x1="11" y1="8" x2="11" y2="14"/>
                        <line x1="8" y1="11" x2="14" y2="11"/>
                      </svg>
                      <span class="overlay-title">Click to Enlarge</span>
                      <span class="overlay-meta">1024 × 2079 Full Resolution</span>
                    </div>
                  </a>
                </div>
                <div class="screenshot-card-footer">
                  <div class="screenshot-card-info">
                    <span class="screenshot-tag">Screenshot {idx + 1}</span>
                    <span class="screenshot-dims">1024 × 2079</span>
                  </div>
                  <div class="screenshot-card-actions">
                    <button
                      type="button"
                      class="btn-card-action btn-zoom-action"
                      data-src={src}
                      data-index={idx}
                      title="Open directly at 100% full size (1024×2079)"
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                      100% Size
                    </button>
                    <a
                      href={src}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-card-action btn-tab-action"
                      title="Open raw image in new tab"
                    >
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- ── Related Movies (Poster Grid) ── -->
      {relatedVideos.length > 0 && (
        <section class="related-section" aria-label="Related movies">
          <h2 class="section-title">{related.length > 0 ? `More ${category} Movies` : 'Recommended Movies'}</h2>
          <div class="video-grid movie-poster-grid">
            {relatedVideos.map((v) => <VideoCard video={v} showTitle={false} />)}
          </div>
        </section>
      )}

    </article>
  </div>

  <!-- ── Image Lightbox Modal (Full 1024x2079 Enlarger) ── -->
  <div id="lightbox-modal" class="lightbox-modal" role="dialog" aria-modal="true" aria-label="Screenshot Full View Lightbox" aria-hidden="true">
    <div class="lightbox-backdrop" id="lightbox-backdrop"></div>

    <!-- Top Floating Toolbar -->
    <div class="lightbox-toolbar">
      <div class="lightbox-toolbar-left">
        <span class="lightbox-counter" id="lightbox-counter">1 / 1</span>
        <span class="lightbox-dimensions-badge" id="lightbox-dimensions-badge">1024 × 2079 px</span>
      </div>

      <div class="lightbox-toolbar-center">
        <!-- Main 100% Full Size Toggle Button -->
        <button type="button" class="lightbox-btn" id="lightbox-toggle-zoom" title="Toggle 100% Full Size (1024×2079) [Z / F]">
          <svg id="icon-zoom-in" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <svg id="icon-zoom-out" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <span id="lightbox-zoom-text">100% Full Size</span>
        </button>

        <button type="button" class="lightbox-btn lightbox-btn-icon-only" id="lightbox-zoom-out" title="Zoom Out (-)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>

        <span class="lightbox-zoom-level" id="lightbox-zoom-level">Fit</span>

        <button type="button" class="lightbox-btn lightbox-btn-icon-only" id="lightbox-zoom-in" title="Zoom In (+)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>

        <a id="lightbox-orig-link" href="#" target="_blank" rel="noopener noreferrer" class="lightbox-btn" title="Open full raw image in new tab">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Open Original</span>
        </a>
      </div>

      <div class="lightbox-toolbar-right">
        <button type="button" class="lightbox-close-btn" id="lightbox-close" aria-label="Close lightbox" title="Close (Esc)">
          &times;
        </button>
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button type="button" class="lightbox-nav-btn lightbox-prev" id="lightbox-prev" aria-label="Previous screenshot" title="Previous (←)">
      &#10094;
    </button>
    <button type="button" class="lightbox-nav-btn lightbox-next" id="lightbox-next" aria-label="Next screenshot" title="Next (→)">
      &#10095;
    </button>

    <!-- Scrollable Image Viewport -->
    <div class="lightbox-viewport" id="lightbox-viewport">
      <div class="lightbox-img-wrapper" id="lightbox-img-wrapper">
        <img id="lightbox-img" src="" alt="Full view screenshot" />
      </div>
    </div>

    <!-- Bottom Hint -->
    <div class="lightbox-hint-bar" id="lightbox-hint-bar">
      <span>💡 Click image to toggle 100% full size (1024 × 2079) • Scroll or drag to explore details</span>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ videoSlug: slug, defaultLikes: likesCount, defaultDislikes: dislikesCount }}>
  // ════════════════════════════════════════════════════════
  //  INTERACTIVE CLIENT LOGIC
  // ════════════════════════════════════════════════════════

  // 1. Stream Player Toggle
  const toggleStreamBtn = document.getElementById('toggle-stream-btn');
  const streamSection = document.getElementById('stream-player-section');
  const closeStreamBtn = document.getElementById('close-stream-btn');

  toggleStreamBtn?.addEventListener('click', () => {
    if (streamSection) {
      streamSection.style.display = 'block';
      streamSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  closeStreamBtn?.addEventListener('click', () => {
    if (streamSection) streamSection.style.display = 'none';
  });

  // 3. Rating (Likes / Dislikes) with localStorage
  const likeBtn = document.getElementById('btn-like');
  const dislikeBtn = document.getElementById('btn-dislike');
  const likeCountEl = document.getElementById('like-count');
  const dislikeCountEl = document.getElementById('dislike-count');

  const ratingKey = `rating_${videoSlug}`;
  let currentRating = localStorage.getItem(ratingKey);

  let likes = defaultLikes;
  let dislikes = defaultDislikes;

  if (currentRating === 'like') {
    likes += 1;
    likeBtn?.classList.add('active');
  } else if (currentRating === 'dislike') {
    dislikes += 1;
    dislikeBtn?.classList.add('active');
  }

  function updateRatingDisplay() {
    if (likeCountEl) likeCountEl.textContent = `${likes} Likes`;
    if (dislikeCountEl) dislikeCountEl.textContent = `${dislikes} Dislikes`;
  }
  updateRatingDisplay();

  likeBtn?.addEventListener('click', () => {
    if (currentRating === 'like') {
      likes -= 1;
      currentRating = null;
      localStorage.removeItem(ratingKey);
      likeBtn.classList.remove('active');
    } else {
      if (currentRating === 'dislike') {
        dislikes -= 1;
        dislikeBtn?.classList.remove('active');
      }
      likes += 1;
      currentRating = 'like';
      localStorage.setItem(ratingKey, 'like');
      likeBtn.classList.add('active');
    }
    updateRatingDisplay();
  });

  dislikeBtn?.addEventListener('click', () => {
    if (currentRating === 'dislike') {
      dislikes -= 1;
      currentRating = null;
      localStorage.removeItem(ratingKey);
      dislikeBtn.classList.remove('active');
    } else {
      if (currentRating === 'like') {
        likes -= 1;
        likeBtn?.classList.remove('active');
      }
      dislikes += 1;
      currentRating = 'dislike';
      localStorage.setItem(ratingKey, 'dislike');
      dislikeBtn.classList.add('active');
    }
    updateRatingDisplay();
  });

  // 4. Enhanced Screenshot Viewer & 1024x2079 Full Dimension Lightbox
  const screenshotLinks = Array.from(document.querySelectorAll('.screenshot-link'));
  const screenshotUrls = screenshotLinks.map((l) => l.getAttribute('data-src') || l.getAttribute('href') || '');

  // On-page Grid / Full-width switcher
  const btnViewGrid = document.getElementById('btn-view-grid');
  const btnViewFull = document.getElementById('btn-view-full');
  const screenshotsGrid = document.getElementById('screenshots-grid');

  function setScreenshotViewMode(mode) {
    if (mode === 'full') {
      screenshotsGrid?.classList.add('full-width-mode');
      btnViewFull?.classList.add('active');
      btnViewGrid?.classList.remove('active');
      try { localStorage.setItem('px_screenshot_view_mode', 'full'); } catch {}
    } else {
      screenshotsGrid?.classList.remove('full-width-mode');
      btnViewGrid?.classList.add('active');
      btnViewFull?.classList.remove('active');
      try { localStorage.setItem('px_screenshot_view_mode', 'grid'); } catch {}
    }
  }

  btnViewGrid?.addEventListener('click', () => setScreenshotViewMode('grid'));
  btnViewFull?.addEventListener('click', () => setScreenshotViewMode('full'));

  // Restore saved view mode preference
  try {
    if (localStorage.getItem('px_screenshot_view_mode') === 'full') {
      setScreenshotViewMode('full');
    }
  } catch {}

  // Lightbox elements
  const lightboxModal = document.getElementById('lightbox-modal');
  const lightboxViewport = document.getElementById('lightbox-viewport');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxBackdrop = document.getElementById('lightbox-backdrop');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxDimsBadge = document.getElementById('lightbox-dimensions-badge');
  const lightboxToggleZoom = document.getElementById('lightbox-toggle-zoom');
  const lightboxZoomText = document.getElementById('lightbox-zoom-text');
  const iconZoomIn = document.getElementById('icon-zoom-in');
  const iconZoomOut = document.getElementById('icon-zoom-out');
  const lightboxZoomIn = document.getElementById('lightbox-zoom-in');
  const lightboxZoomOut = document.getElementById('lightbox-zoom-out');
  const lightboxZoomLevel = document.getElementById('lightbox-zoom-level');
  const lightboxOrigLink = document.getElementById('lightbox-orig-link');

  let currentScreenIdx = 0;
  let isZoomed100 = false;
  let customScale = 1.0;
  let isCustomScale = false;

  function updateLightboxControls() {
    if (!screenshotUrls.length) return;
    if (lightboxCounter) {
      lightboxCounter.textContent = `${currentScreenIdx + 1} / ${screenshotUrls.length}`;
    }
    if (lightboxPrev) {
      lightboxPrev.style.display = screenshotUrls.length > 1 ? 'flex' : 'none';
    }
    if (lightboxNext) {
      lightboxNext.style.display = screenshotUrls.length > 1 ? 'flex' : 'none';
    }
    if (lightboxOrigLink) {
      lightboxOrigLink.setAttribute('href', screenshotUrls[currentScreenIdx] || '#');
    }
  }

  function applyZoomMode(zoom, ratioY = 0) {
    if (!lightboxImg || !lightboxViewport) return;
    isZoomed100 = zoom;
    isCustomScale = false;
    customScale = 1.0;

    const natW = lightboxImg.naturalWidth || 1024;
    const natH = lightboxImg.naturalHeight || 2079;

    if (lightboxDimsBadge) {
      lightboxDimsBadge.textContent = `${natW} × ${natH} px`;
    }

    if (zoom) {
      // 100% Actual Full Dimension mode
      lightboxViewport.classList.add('is-scrollable', 'is-zoomed', 'can-pan');
      lightboxImg.style.width = `${natW}px`;
      lightboxImg.style.maxWidth = 'none';
      lightboxImg.style.maxHeight = 'none';

      if (lightboxZoomText) lightboxZoomText.textContent = 'Fit to Screen';
      if (lightboxZoomLevel) lightboxZoomLevel.textContent = '100%';
      if (iconZoomIn) iconZoomIn.style.display = 'none';
      if (iconZoomOut) iconZoomOut.style.display = 'inline-block';
      lightboxToggleZoom?.classList.add('btn-active-zoom');

      // Center around clicked point if ratio provided
      if (ratioY > 0) {
        requestAnimationFrame(() => {
          const targetY = (ratioY * natH) - (lightboxViewport.clientHeight / 2);
          lightboxViewport.scrollTop = Math.max(0, targetY);
        });
      }
    } else {
      // Fit to Screen mode
      lightboxViewport.classList.remove('is-scrollable', 'is-zoomed', 'can-pan');
      lightboxImg.style.width = 'auto';
      lightboxImg.style.maxWidth = '95vw';
      lightboxImg.style.maxHeight = 'calc(100vh - 120px)';

      if (lightboxZoomText) lightboxZoomText.textContent = '100% Full Size';
      if (lightboxZoomLevel) lightboxZoomLevel.textContent = 'Fit';
      if (iconZoomIn) iconZoomIn.style.display = 'inline-block';
      if (iconZoomOut) iconZoomOut.style.display = 'none';
      lightboxToggleZoom?.classList.remove('btn-active-zoom');
    }
  }

  function setScale(scale) {
    if (!lightboxImg || !lightboxViewport) return;
    isCustomScale = true;
    customScale = Math.min(2.5, Math.max(0.4, scale));
    isZoomed100 = customScale >= 0.95 && customScale <= 1.05;

    const natW = lightboxImg.naturalWidth || 1024;

    lightboxViewport.classList.add('is-scrollable', 'is-zoomed', 'can-pan');
    lightboxImg.style.width = `${Math.round(natW * customScale)}px`;
    lightboxImg.style.maxWidth = 'none';
    lightboxImg.style.maxHeight = 'none';

    if (lightboxZoomLevel) {
      lightboxZoomLevel.textContent = `${Math.round(customScale * 100)}%`;
    }
    if (lightboxZoomText) {
      lightboxZoomText.textContent = 'Fit to Screen';
    }
    if (iconZoomIn) iconZoomIn.style.display = 'none';
    if (iconZoomOut) iconZoomOut.style.display = 'inline-block';
    lightboxToggleZoom?.classList.add('btn-active-zoom');
  }

  function openLightbox(idx, startZoomed = false) {
    if (!screenshotUrls[idx] || !lightboxImg || !lightboxModal) return;
    currentScreenIdx = idx;
    lightboxImg.src = screenshotUrls[idx];
    updateLightboxControls();

    lightboxModal.classList.add('active');
    lightboxModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    lightboxImg.onload = () => {
      const natW = lightboxImg.naturalWidth || 1024;
      const natH = lightboxImg.naturalHeight || 2079;
      if (lightboxDimsBadge) {
        lightboxDimsBadge.textContent = `${natW} × ${natH} px`;
      }
      if (startZoomed) {
        applyZoomMode(true);
      } else {
        applyZoomMode(false);
      }
    };

    if (lightboxImg.complete && lightboxImg.naturalWidth > 0) {
      if (startZoomed) {
        applyZoomMode(true);
      } else {
        applyZoomMode(false);
      }
    }
  }

  function closeLightbox() {
    if (lightboxModal) {
      lightboxModal.classList.remove('active');
      lightboxModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lightboxImg) lightboxImg.src = '';
      applyZoomMode(false);
    }
  }

  function nextScreenshot() {
    if (!screenshotUrls.length) return;
    const nextIdx = (currentScreenIdx + 1) % screenshotUrls.length;
    openLightbox(nextIdx, isZoomed100);
  }

  function prevScreenshot() {
    if (!screenshotUrls.length) return;
    const prevIdx = (currentScreenIdx - 1 + screenshotUrls.length) % screenshotUrls.length;
    openLightbox(prevIdx, isZoomed100);
  }

  // Hook on-page links & buttons
  document.querySelectorAll('.screenshot-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const idx = parseInt(link.getAttribute('data-index') || '0', 10);
      openLightbox(idx, false);
    });
  });

  document.querySelectorAll('.btn-zoom-action').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
      openLightbox(idx, true);
    });
  });

  // Lightbox click-to-enlarge & drag-to-pan handling
  let isMouseDown = false;
  let startX = 0;
  let startY = 0;
  let scrollStartX = 0;
  let scrollStartY = 0;
  let hasMoved = false;

  lightboxImg?.addEventListener('mousedown', (e) => {
    if (!isZoomed100 && !isCustomScale) return;
    isMouseDown = true;
    hasMoved = false;
    startX = e.clientX;
    startY = e.clientY;
    scrollStartX = lightboxViewport?.scrollLeft || 0;
    scrollStartY = lightboxViewport?.scrollTop || 0;
    lightboxViewport?.classList.add('is-panning');
  });

  window.addEventListener('mousemove', (e) => {
    if (!isMouseDown || !lightboxViewport) return;
    const dx = e.clientX - startX;
    const dy = e.clientY - startY;
    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
      hasMoved = true;
      lightboxViewport.scrollLeft = scrollStartX - dx;
      lightboxViewport.scrollTop = scrollStartY - dy;
    }
  });

  window.addEventListener('mouseup', () => {
    if (isMouseDown) {
      isMouseDown = false;
      lightboxViewport?.classList.remove('is-panning');
    }
  });

  lightboxImg?.addEventListener('click', (e) => {
    if (hasMoved) return; // Was a pan drag, ignore click
    if (!isZoomed100 && !isCustomScale) {
      // Calculate relative vertical ratio of click for smooth centering
      const rect = lightboxImg.getBoundingClientRect();
      const ratioY = (e.clientY - rect.top) / rect.height;
      applyZoomMode(true, ratioY);
    } else {
      applyZoomMode(false);
    }
  });

  lightboxToggleZoom?.addEventListener('click', () => {
    applyZoomMode(!isZoomed100);
  });

  lightboxZoomIn?.addEventListener('click', () => {
    if (!isZoomed100 && !isCustomScale) {
      applyZoomMode(true);
    } else {
      setScale(customScale + 0.25);
    }
  });

  lightboxZoomOut?.addEventListener('click', () => {
    if (customScale <= 0.6) {
      applyZoomMode(false);
    } else {
      setScale(customScale - 0.25);
    }
  });

  lightboxPrev?.addEventListener('click', prevScreenshot);
  lightboxNext?.addEventListener('click', nextScreenshot);
  lightboxBackdrop?.addEventListener('click', closeLightbox);
  lightboxClose?.addEventListener('click', closeLightbox);

  window.addEventListener('keydown', (e) => {
    if (!lightboxModal?.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowRight') nextScreenshot();
    if (e.key === 'ArrowLeft') prevScreenshot();
    if (e.key === 'z' || e.key === 'Z' || e.key === 'f' || e.key === 'F') {
      applyZoomMode(!isZoomed100);
    }
    if (e.key === '+' || e.key === '=') {
      setScale((isCustomScale ? customScale : 1.0) + 0.25);
    }
    if (e.key === '-') {
      setScale((isCustomScale ? customScale : 1.0) - 0.25);
    }
  });

  // 5. Views Tracking
  const SESSION_KEY = `viewed:${videoSlug}`;
  async function trackView() {
    const alreadyCounted = sessionStorage.getItem(SESSION_KEY);
    const method = alreadyCounted ? 'GET' : 'POST';
    try {
      const res = await fetch(`/api/views?slug=${encodeURIComponent(videoSlug)}`, { method });
      if (!res.ok) return;
      const data = await res.json();
      if (!alreadyCounted) sessionStorage.setItem(SESSION_KEY, '1');
    } catch {}
  }
  trackView();
</script>
