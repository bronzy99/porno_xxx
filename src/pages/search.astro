---
// src/pages/search.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard  from '../components/VideoCard.astro';
import { videos, SITE_CONFIG } from '../data/videos';
---

<BaseLayout
  title={`Search – ${SITE_CONFIG.name}`}
  description={`Search for adult videos on ${SITE_CONFIG.name}.`}
  noindex={true}
>

  <div class="container">

    <div class="search-page-header">
      <h1>Search Videos</h1>
      <p>Search by title, category, or tag</p>
    </div>

    <form class="search-page-form" id="search-form" role="search">
      <div class="search-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="search"
          id="search-input"
          name="q"
          placeholder="Search videos, tags, categories…"
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          aria-label="Search videos"
        />
      </div>
      <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <!-- Sort -->
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;flex-wrap:wrap">
      <span style="font-size:.85rem;color:var(--text-muted);font-weight:500">Sort:</span>
      <div class="sort-options" role="group" aria-label="Sort results">
        <button class="sort-btn active" data-sort="date"  aria-pressed="true">Latest</button>
        <button class="sort-btn"        data-sort="views" aria-pressed="false">Most Viewed</button>
        <button class="sort-btn"        data-sort="alpha" aria-pressed="false">A–Z</button>
      </div>
    </div>

    <p id="results-meta" class="results-meta" aria-live="polite"></p>

    <!-- Pre-render all cards (hidden) for instant client-side search -->
    <div class="video-grid" id="results-grid" role="list" aria-label="Search results">
      {videos.map(video => <VideoCard video={video} />)}
    </div>

    <div class="empty-state" id="empty-state" style="display:none">
      <div class="empty-icon">🔍</div>
      <h3>No results found</h3>
      <p>Try different keywords, or <a href="/" style="color:var(--accent)">browse all videos</a>.</p>
    </div>

    <div class="load-more-wrap" id="load-more-wrap" style="display:none">
      <button class="btn btn-ghost" id="load-more-btn">Load More</button>
    </div>

  </div>
</BaseLayout>

<script define:vars={{ PER_PAGE: SITE_CONFIG.videosPerPage }}>
  // ════════════════════════════════════════════════════════
  //  SEARCH PAGE — all cards are pre-rendered in the HTML.
  //  JS filters by showing/hiding based on the query.
  // ════════════════════════════════════════════════════════

  const searchInput = /** @type {HTMLInputElement|null} */ (document.getElementById('search-input'));
  const grid        = document.getElementById('results-grid');
  const emptyState  = document.getElementById('empty-state');
  const loadWrap    = document.getElementById('load-more-wrap');
  const loadBtn     = document.getElementById('load-more-btn');
  const metaEl      = document.getElementById('results-meta');

  let allCards     = [];
  let matchedCards = [];
  let shownCount   = 0;
  let currentQuery = '';
  let currentSort  = 'date';

  function getCards() {
    return Array.from(grid?.querySelectorAll('.video-card') ?? []);
  }

  function sortCards(cards, sort) {
    const order = [...cards];
    if (sort === 'date') {
      order.sort((a, b) => new Date(b.dataset.date).getTime() - new Date(a.dataset.date).getTime());
    } else if (sort === 'alpha') {
      order.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
    }
    order.forEach(c => grid?.appendChild(c));
    return order;
  }

  function runSearch(query) {
    currentQuery = query.trim().toLowerCase();
    shownCount   = 0;
    allCards     = getCards();

    if (!currentQuery) {
      // No query → show all sorted by date
      matchedCards = sortCards(allCards, currentSort);
    } else {
      matchedCards = allCards.filter(card => {
        const title    = (card.dataset.title || '').toLowerCase();
        const category = (card.dataset.category || '').toLowerCase();
        const tags     = (card.dataset.tags || '').toLowerCase();
        return (
          title.includes(currentQuery) ||
          category.includes(currentQuery) ||
          tags.includes(currentQuery)
        );
      });
      matchedCards = sortCards(matchedCards, currentSort);
    }

    // Hide all
    allCards.forEach(c => c.classList.add('hidden'));

    // Update meta
    if (metaEl) {
      if (!currentQuery) {
        metaEl.textContent = `Showing all ${allCards.length} videos`;
      } else if (matchedCards.length === 0) {
        metaEl.textContent = '';
      } else {
        metaEl.innerHTML = `Found <strong>${matchedCards.length}</strong> result${matchedCards.length !== 1 ? 's' : ''} for "<strong>${currentQuery}</strong>"`;
      }
    }

    // Empty state
    if (emptyState) emptyState.style.display = (currentQuery && matchedCards.length === 0) ? 'block' : 'none';

    showMore();
  }

  function showMore() {
    matchedCards.slice(shownCount, shownCount + PER_PAGE).forEach(c => c.classList.remove('hidden'));
    shownCount = Math.min(shownCount + PER_PAGE, matchedCards.length);
    if (loadWrap) loadWrap.style.display = shownCount < matchedCards.length ? 'block' : 'none';
  }

  // ── Submit ────────────────────────────────────────────────
  document.getElementById('search-form')?.addEventListener('submit', e => {
    e.preventDefault();
    const q = searchInput?.value || '';
    history.replaceState(null, '', `?q=${encodeURIComponent(q)}`);
    runSearch(q);
  });

  // ── Live (debounced) ─────────────────────────────────────
  let debounce;
  searchInput?.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => {
      const q = searchInput.value;
      history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : '?');
      runSearch(q);
    }, 260);
  });

  // ── Sort ─────────────────────────────────────────────────
  document.querySelectorAll('.sort-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sort-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      currentSort = btn.dataset.sort || 'date';
      runSearch(searchInput?.value || '');
    });
  });

  // ── Load More ────────────────────────────────────────────
  loadBtn?.addEventListener('click', showMore);

  // ── Init from URL ─────────────────────────────────────────
  const urlQ = new URLSearchParams(window.location.search).get('q') || '';
  if (searchInput && urlQ) searchInput.value = urlQ;
  runSearch(urlQ);
</script>
