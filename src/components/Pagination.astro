---
// src/components/Pagination.astro
import type { Page } from 'astro';

interface Props {
  page: Page<any>;
  baseUrl: string; // e.g. "/category/amateur" or "/tags/threesome"
}

const { page, baseUrl } = Astro.props;
const cleanBase = baseUrl.replace(/\/+$/, '');

function getPageUrl(pageNum: number): string {
  if (pageNum <= 1) {
    return `${cleanBase}/`;
  }
  return `${cleanBase}/${pageNum}/`;
}

// Generate pagination numbers array with smart ellipsis
const totalPages = page.lastPage;
const current = page.currentPage;

const pageNumbers: (number | '...')[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
} else {
  pageNumbers.push(1);
  if (current > 3) pageNumbers.push('...');
  const start = Math.max(2, current - 1);
  const end = Math.min(totalPages - 1, current + 1);
  for (let i = start; i <= end; i++) pageNumbers.push(i);
  if (current < totalPages - 2) pageNumbers.push('...');
  pageNumbers.push(totalPages);
}
---

{totalPages > 1 && (
  <nav class="pagination-wrap" aria-label="Pagination Navigation">
    <div class="pagination-nav">
      <!-- Previous Page -->
      {page.url.prev ? (
        <a href={page.url.prev} class="pagination-btn" rel="prev" aria-label="Previous page">
          ‹ Prev
        </a>
      ) : (
        <span class="pagination-btn disabled" aria-disabled="true">
          ‹ Prev
        </span>
      )}

      <!-- Page Numbers -->
      {pageNumbers.map((num) => {
        if (num === '...') {
          return <span class="pagination-ellipsis">&hellip;</span>;
        }
        const isCurrent = num === current;
        return isCurrent ? (
          <span class="pagination-btn active" aria-current="page">
            {num}
          </span>
        ) : (
          <a href={getPageUrl(num)} class="pagination-btn" aria-label={`Go to page ${num}`}>
            {num}
          </a>
        );
      })}

      <!-- Next Page -->
      {page.url.next ? (
        <a href={page.url.next} class="pagination-btn" rel="next" aria-label="Next page">
          Next ›
        </a>
      ) : (
        <span class="pagination-btn disabled" aria-disabled="true">
          Next ›
        </span>
      )}
    </div>

    <div class="pagination-info">
      Showing <strong>{page.start + 1}–{page.end + 1}</strong> of <strong>{page.total}</strong> videos (Page {current} of {totalPages})
    </div>
  </nav>
)}
