---
// src/components/VideoCard.astro
import type { Video } from '../data/videos';
import { slugify, formatDate, getQualityTierBadge } from '../data/videos';

interface Props {
  video: Video;
  showTitle?: boolean;
}

const { video, showTitle = true } = Astro.props;
const slug         = slugify(video.title);
const previewUrl   = video.preview?.trim() || '';
const hasPreview   = Boolean(previewUrl);
const isGif        = Boolean(previewUrl.toLowerCase().endsWith('.gif'));
const qualityTier  = getQualityTierBadge(video);
const initialViews = video.views || 0;
const formattedViews = initialViews >= 1_000_000
  ? (initialViews / 1_000_000).toFixed(1) + 'M'
  : initialViews >= 1_000
    ? Math.floor(initialViews / 1_000) + 'K'
    : (initialViews > 0 ? String(initialViews) : '—');
const category = video.category || 'Movies';
const posterImg = video.poster || video.thumbnail;
const sceneCount = video.scenes?.length;
---

<article
  class={`video-card ${!showTitle ? 'video-card-poster-only' : ''}`}
  data-category={category}
  data-date={video.date}
  data-title={video.title.toLowerCase()}
  data-tags={video.tags.join(',')}
  data-views={initialViews}
>
  <a href={`/videos/${slug}/`} class="card-link" title={video.title}>
    <div class="card-thumb" data-has-preview={hasPreview ? 'true' : 'false'}>
      <!-- Quality Tier Tag Badge -->
      <span class={`quality-badge ${qualityTier.tierClass}`} aria-label={`Quality: ${qualityTier.label}`}>
        {qualityTier.label}
      </span>

      <!-- Poster Image -->
      <img
        class="thumb-img"
        src={posterImg}
        alt={video.title}
        loading="lazy"
        width="400"
        height="600"
        referrerpolicy="no-referrer"
        onerror="this.src='https://picsum.photos/400/600?grayscale'"
      />

      {hasPreview && (
        <div class="preview-wrap">
          {!isGif && (
            <video
              class="preview-video"
              muted
              loop
              playsinline
              preload="none"
              referrerpolicy="no-referrer"
            >
              <source src={previewUrl} type="video/mp4" />
              <source src={previewUrl} />
            </video>
          )}
          <img
            class="preview-img"
            data-src={previewUrl}
            alt={`Preview of ${video.title}`}
            referrerpolicy="no-referrer"
            loading="lazy"
            width="400"
            height="600"
            style={!isGif ? "display: none;" : ""}
            src={isGif ? previewUrl : undefined}
          />
        </div>
      )}

      <div class="card-play-overlay" aria-hidden="true">
        <div class="card-play-circle">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
      </div>

      <!-- Scenes badge if available -->
      {sceneCount ? (
        <span class="scene-count-badge" aria-label={`${sceneCount} Scenes`}>
          {sceneCount} Scenes
        </span>
      ) : null}

      <!-- Duration badge -->
      <span class="duration-badge" aria-label={`Duration: ${video.duration}`}>
        {video.duration}
      </span>
    </div>

    <!-- Post Title and Meta (Omitted on homepage as requested) -->
    {showTitle && (
      <div class="card-body">
        <h3 class="card-title">{video.cleanTitle || video.title}</h3>
        <div class="card-meta">
          <div class="card-meta-left">
            <span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <span class="card-view-count" data-slug={slug} data-raw-views={initialViews}>{formattedViews}</span>
            </span>
            <span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              {formatDate(video.date)}
            </span>
          </div>
          <span class="category-tag">{category}</span>
        </div>
      </div>
    )}
  </a>
</article>

<script>
  function setupHoverPreviews() {
    const cards = document.querySelectorAll<HTMLElement>('.video-card');

    cards.forEach((card) => {
      if (card.dataset.previewInit === 'true') return;
      card.dataset.previewInit = 'true';

      const thumb = card.querySelector<HTMLElement>('.card-thumb');
      if (thumb?.dataset.hasPreview !== 'true') return;

      const video = card.querySelector<HTMLVideoElement>('.preview-video');
      const img   = card.querySelector<HTMLImageElement>('.preview-img');
      if (!video && !img) return;

      let timer: number | null = null;

      // Fallback: If video element encounters an error, display img
      if (video) {
        video.addEventListener('error', () => {
          video.style.display = 'none';
          if (img) {
            img.style.display = 'block';
            if (img.dataset.src && !img.src) {
              img.src = img.dataset.src;
            }
          }
        });
      }

      card.addEventListener('mouseenter', () => {
        if (timer) window.clearTimeout(timer);

        timer = window.setTimeout(() => {
          if (video && video.style.display !== 'none') {
            video.muted = true;
            if (video.currentTime > 0 && video.ended) {
              video.currentTime = 0;
            }
            const promise = video.play();
            if (promise !== undefined) {
              promise
                .then(() => {
                  card.classList.add('has-active-preview');
                  video.classList.add('is-playing');
                })
                .catch(() => {
                  // Fallback to img if video playback prevented
                  if (img) {
                    img.style.display = 'block';
                    if (img.dataset.src && !img.src) {
                      img.src = img.dataset.src;
                    }
                    card.classList.add('has-active-preview');
                    img.classList.add('is-visible');
                  }
                });
            }
          } else if (img) {
            if (img.dataset.src && !img.src) {
              img.src = img.dataset.src;
            }
            card.classList.add('has-active-preview');
            img.classList.add('is-visible');
          }
        }, 50);
      });

      card.addEventListener('mouseleave', () => {
        if (timer) {
          window.clearTimeout(timer);
          timer = null;
        }

        card.classList.remove('has-active-preview');

        if (video) {
          video.pause();
          video.currentTime = 0;
          video.classList.remove('is-playing');
        }

        if (img) {
          img.classList.remove('is-visible');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHoverPreviews);
  } else {
    setupHoverPreviews();
  }
  document.addEventListener('astro:page-load', setupHoverPreviews);
</script>
